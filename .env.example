# MongoDB Connection String (from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/TypeCast?retryWrites=true&w=majority

# JWT Secret for signing authentication tokens (Generate via `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_here

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model name (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Next.js Application Public URL (e.g., https://typecast.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
